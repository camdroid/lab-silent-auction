# Copy to .env and fill in. Never commit .env.

# The secret part of every link: https://your-host/t/<TRACKER_TOKEN>/
# Generate with: openssl rand -hex 16
TRACKER_TOKEN=

# The LAB spreadsheet's ID: the long string in its URL between /d/ and /edit.
# Leave empty to run in local mode (sample lots, progress saved in ./data).
GOOGLE_SHEET_ID=

# Name of the tab with one row per lot. Leave empty to auto-detect it
# (the first tab whose header row has "Lot ID" and "Lot Title").
BUNDLE_SHEET_NAME=

# Only change these if the bundle tab's headers differ.
# COL_LOT_ID=Lot ID
# COL_TITLE=Lot Title
# COL_SUBTITLE=Subtitle
# COL_DESCRIPTION=Lot Description
# COL_TYPE=Physical or Virtual
# Optional per-lot link for the "Open in 32Auctions" button:
# COL_AUCTION_URL=32Auctions URL

# Where "Open in 32Auctions" goes for lots without their own link,
# e.g. your auction's admin page.
AUCTION_URL=https://www.32auctions.com

# Tabs the tracker creates and writes to.
# TRACKER_SHEET_NAME=Tracker
# FLAGS_SHEET_NAME=Flags

TZ=America/Chicago
# REFRESH_SECONDS=20
# MAX_PHOTO_MB=100

# Only for the cloudflared service (docker compose --profile tunnel up -d).
CLOUDFLARE_TUNNEL_TOKEN=
